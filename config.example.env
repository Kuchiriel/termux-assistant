# termux-assistant - exemplo de config.
# Copie para ~/.config/termux-assistant/config.env (o setup_bot.sh gera esse arquivo).
# Segredos NAO vao aqui: use variaveis de ambiente (ex.: OPENAI_API_KEY).

TA_BACKEND=opencode          # opencode | openai | ollama
TA_MODEL=nvidia/minimaxai/minimax-m3.1-flash
TA_LANG=pt-br                # idioma do TTS
TA_STREAM=false              # falar por sentenca enquanto gera
TA_TIMEOUT=120               # timeout (s) das chamadas de rede
TA_TTS=true                  # falar as respostas
TA_OPENAI_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
TA_OLLAMA_HOST=http://127.0.0.1:11434
