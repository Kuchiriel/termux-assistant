#!/data/data/com.termux/files/usr/bin/bash
# crouton-resume - retoma a sessao mais recente do OpenCode (ou a do agente).
# Abre o TUI com `opencode --session <id>`.

set -uo pipefail
say() { printf '%s\n' "$*"; }

data=$(opencode api GET /api/session 2>/dev/null)
[[ -z "$data" ]] && { say "servico do OpenCode nao respondeu"; exit 1; }

id=$(printf '%s' "$data" | jq -r '
  (.data // .)
  | sort_by(.time.updated // .time.created // 0) | reverse
  | .[0].id // empty' 2>/dev/null)

[[ -z "$id" ]] && { say "nenhuma sessao encontrada"; exit 1; }

titulo=$(printf '%s' "$data" | jq -r --arg id "$id" '(.data // .)[] | select(.id == $id) | (.title // "(sem titulo)")' 2>/dev/null)
say "retomando: $titulo"
say "$id"
say ""
termux-toast "Abrindo: $titulo" >/dev/null 2>&1 || true

# abre o TUI do OpenCode na sessao escolhida
if command -v termux-open >/dev/null 2>&1; then
  termux-open --es "com.termux.app" "/data/data/com.termux/files/usr/bin/opencode" >/dev/null 2>&1 || true
fi
exec opencode --session "$id" 2>&1
