#!/data/data/com.termux/files/usr/bin/bash
# crouton-offline-ask — pergunta livre, resposta do corpus local (sem internet/LLM).
set -uo pipefail
export PATH="$HOME/bin:$PATH"
q="${OFFLINE_WIDGET_QUERY:-}"
if [ -z "$q" ]; then
  q="$(termux-dialog text -t "Pergunta de sobrevivencia (PT/EN)" -i "" \
    | python3 -c 'import json,sys; print((json.load(sys.stdin).get("text") or "").strip())')"
fi
[ -z "$q" ] && exit 0
A="$HOME/projects/termux-assistant/blackout/offline_answer.py"
[ -f "$A" ] || A="$HOME/.local/share/termux-assistant/blackout/offline_answer.py"
out="$(timeout 30 python3 "$A" "$q" 2>&1)"
termux-vibrate -d 40 2>/dev/null || true
if [ "${OFFLINE_WIDGET_STDOUT:-0}" = "1" ]; then printf '%s\n' "$out"; exit 0; fi
termux-dialog text -t "Offline: $q" -i "$out" >/dev/null 2>&1 || printf '%s\n' "$out" | termux-toast -g middle
