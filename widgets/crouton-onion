#!/data/data/com.termux/files/usr/bin/bash
# crouton-onion - pede ao host NixOS (Arara / jarvis@nitro-v15) que suba o tunel onion.
#
# Fluxo:
#   1) guard: o egress do container tem de estar verificado (Tor na perna A).
#      Se o container sair pelo IP residencial, o pedido NAO e enviado.
#   2) confirma com o dono (dialog).
#   3) publica o pedido no barramento (issue #12 do mt5) com o comando exato.
#
# A senha NAO vai no barramento: ela esta staged no container do host.

set -uo pipefail
export PATH="$PATH:$HOME/bin"
REPO="Kuchiriel/mt5"
ISSUE=12
AGENT="tab"
TO="jarvis@nitro-v15"        # Arara, dono do ~/projects/vpnsec

say() { printf '%s\n' "$*"; }
toast() { termux-toast "$1" >/dev/null 2>&1 || true; }

# ---------- 1) guard ----------
say "1) verificando o egress do container..."
check=$(timeout 240 "$HOME/bin/egress-guard" 2>&1)
if printf '%s' "$check" | grep -q "ABORTADO"; then
  toast "Egress inseguro: pedido NAO enviado"
  printf '%s\n' "$check" | tail -4
  exit 1
fi
if ! printf '%s' "$check" | grep -q "IsTor:true"; then
  toast "Egress incerto: pedido NAO enviado"
  printf '%s\n' "$check" | tail -3
  exit 1
fi
say "   ok: egress por Tor (IsTor:true)"

# ---------- 2) confirmacao ----------
if command -v termux-dialog >/dev/null 2>&1; then
  r=$(termux-dialog -t "Subir o tunel onion?" -i "O pedido vai para o Arara (host NixOS). Confirma?" \
      -b "Sim, pode" -b "Nao" 2>/dev/null | jq -r '.code // .text // empty' 2>/dev/null)
  if [[ "$r" != "0" && -n "$r" ]]; then
    say "cancelado."
    exit 0
  fi
fi

# ---------- 3) publica no barramento ----------
note='PEDIDO: subir o tunel onion do nitrov15 no host (TAB / Termux).

PRE-CHECK JA FEITO pelo celular: o egress do container esta verificado como EXIT TOR (IsTor:true).
Nao rode nada que saia pelo IP residencial.

Comandos sugeridos no host (NixOS):
  1) checar egress com Proton: curl -s https://api.ipify.org   (NUNCA pode dar 187.106.139.139)
  2) com Proton ativo (perna B / UDP) ou via Tor (perna A / TCP):
     docker exec -it -u root vpnsec-onion sh -c "proxychains4 -f /etc/proxychains4.conf.vpnsec /usr/bin/onion -s GATEWAY_HOST -u bortolotto"
     (ordem dos prompts: 1) senha  2) "Do you accept? [y]es/[N]o:" do cert)
  3) me avise quando subir: eu rodo o teste do -L do celular.

A credencial esta staged no container (fora do bus): /home/vpnsec/.nitrov15.pass
O tarball do cliente VPN x86_64 tambem esta no container: /home/vpnsec/snxrs-x64.tar.xz (sha256 825cbdee1bf1d620dfab28d1c1cff0932ab1263da3fbb81c0ebb7d99bdf395ce) — o container e i386, entao o IKEv1 roda no HOST, nao dentro dele.'

body=$(python3 - "$AGENT" "$TO" "$note" <<'PY'
import json,sys,datetime
agent,to,note=sys.argv[1],sys.argv[2],sys.argv[3]
ts=datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
p={"kind":"msg","agent":agent,"to":to,"lane":"termux/vpnsec","files":[],
   "intent":"pedir ao host que suba o tunel onion","note":note,"pr":None,"head":"","ts":ts}
print(f"**msg** de `{agent}` na lane `termux/vpnsec` → `{to}`\n\n```coord-json\n"
      + json.dumps(p,indent=2,ensure_ascii=False) + "\n```")
PY
)

if ! command -v gh >/dev/null 2>&1; then
  say "gh nao instalado: nao consegui publicar no barramento."
  exit 1
fi

url=$(printf '%s' "$body" | gh api "repos/$REPO/issues/$ISSUE/comments" -F body=@- -q .html_url 2>/dev/null)
if [[ -z "$url" ]]; then
  toast "Falha ao publicar no bus"
  say "nao consegui publicar no barramento (veja a saida do gh abaixo)"
  printf '%s' "$body" | gh api "repos/$REPO/issues/$ISSUE/comments" -F body=@- 2>&1 | tail -3
  exit 1
fi

toast "Pedido enviado ao Arara"
say "pedido publicado no barramento:"
say "$url"
say ""
say "acompanhe pelo widget 'crouton-bus' ou pelo roster do NixOS."
