# termux-assistant — configuracao local (NUNCA versionar o .env preenchido)
# Copie para ~/.config/termux-assistant/.env e ajuste. Nada aqui e' segredo.

# --- alvos ---
TA_LINUX_USER=nixos
TA_LINUX_HOST6=fd7a:115c:a1e0::7f01:64bd
TA_LINUX_IP4=100.121.100.103
TA_LINUX_LAN=192.168.15.10
TA_LINUX_SSH_PORT=22
TA_PHONE_IP=100.104.175.123
TA_PHONE_SSH_PORT=8022

# --- servicos ---
TA_HUB_URL=http://nitro-v15.tailbcc368.ts.net/hub
TA_HUB_LOCAL=http://127.0.0.1:8091
TA_OPCODE_URL=http://127.0.0.1:52031
TA_LINUX_OC_URL=http://100.121.100.103:4599
TA_LINUX_MCP_URL=http://100.121.100.103:8765/mcp
TA_LINUX_KB_URL=http://100.121.100.103:8766/mcp

# --- arquivos de credencial (caminhos, NAO valores) ---
# O instalador nao copia tokens. Aponte para arquivos locais com permissao 600.
TA_HUB_TOKEN_FILE=$HOME/.config/opencode/agent-hub.token
TA_HF_TOKEN_FILE=$HOME/.cache/huggingface/token
TA_OC_ENV_FILE=$HOME/.config/opencode/server.env

# --- API local (somente loopback por default) ---
TA_API_BIND=127.0.0.1
TA_API_PORT=8787
TA_API_TOKEN_FILE=$HOME/.config/termux-assistant/api.token

# --- modo offline / blackout ---
TA_OFFLINE_BIN=$HOME/bin/offline
TA_OFFLINE_CORPUS=$HOME/offline-corpus
TA_SLM_MODEL=$HOME/models/slm/gemma-3-1b-it-Q4_K_M.gguf
TA_LLAMA_CLI=llama-cli
TA_SLM_THREADS=4
TA_SLM_THREADS_BATCH=8
TA_SLM_CTX=2048
TA_SLM_N=220
TA_LOCAL_MODEL_URL=          # ex.: http://127.0.0.1:8090/v1
TA_API_MODEL=nvidia/minimaxai/minimax-m3.1-flash

# --- comportamento ---
TA_PROFILE=phone             # phone | desktop | minimal | offline
TA_AUTO_REFRESH_WIDGETS=1
TA_BACKUP_DIR=$HOME/storage/shared/termux-assistant/backups
