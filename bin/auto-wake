#!/data/data/com.termux/files/usr/bin/bash
# auto-wake — shim do Termux para o contrato canonico da malha.
#
# A logica e o lock da fila vivem em ai-mesh/shared/scripts/auto-wake. O
# Termux usa este shim para nao manter uma segunda implementacao que possa
# divergir durante um sync.
set -uo pipefail

CANON="${AI_MESH_DIR:-$HOME/ai-mesh}/shared/scripts/auto-wake"
if [ ! -f "$CANON" ]; then
  echo "auto-wake: canonical ausente: $CANON" >&2
  exit 2
fi
exec /data/data/com.termux/files/usr/bin/bash "$CANON" "$@"
