#!/data/data/com.termux/files/usr/bin/python3
"""oc-bridge - ponte OpenAI-compatible para o OpenCode local (Termux).

O `opencode serve` expoe a API nativa do OpenCode (138 rotas), mas NAO tem
/v1/chat/completions. Esta ponte traduz um pedido OpenAI-compatible para um
`opencode run` local, para que qualquer app de chat com "custom endpoint"
(Chatbox, LobeChat, Enchanted...) converse com o seu agente de verdade —
com as ferramentas, as skills e o modelo que voce configurou.

    POST /v1/chat/completions   -> chama `opencode run` e devolve a resposta
    GET  /v1/models             -> modelos disponiveis (opencode models)
    GET  /health                -> estado

Seguranca (por padrao):
    - escuta so em 127.0.0.1 (nao expõe na rede);
    - exige token: Authorization: Bearer $OC_BRIDGE_TOKEN;
    - sem token no ambiente, so aceita requests de 127.0.0.1 com header
      X-Local-Only: 1? NAO: sem token ele NAO SOBE (falha fechada).

Uso:
    OC_BRIDGE_TOKEN=$(openssl rand -hex 16) \\
    OC_BRIDGE_MODEL=nvidia/minimaxai/minimax-m3.1-flash \\
    OC_BRIDGE_PORT=8788 ~/bin/oc-bridge
"""

import os, sys, json, subprocess, urllib.request, urllib.error, hmac
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOST = os.environ.get("OC_BRIDGE_HOST", "127.0.0.1")
PORT = int(os.environ.get("OC_BRIDGE_PORT", "8788"))
TOKEN = os.environ.get("OC_BRIDGE_TOKEN", "").strip()
MODEL = os.environ.get("OC_BRIDGE_MODEL", "nvidia/minimaxai/minimax-m3.1-flash")
TIMEOUT = int(os.environ.get("OC_BRIDGE_TIMEOUT", "300"))
CWD = os.environ.get("OC_BRIDGE_CWD", os.path.expanduser("~/"))

if not TOKEN:
    sys.stderr.write("ABORTADO: defina OC_BRIDGE_TOKEN (a ponte nao sobe sem token).\n")
    sys.exit(2)


def auth_ok(header):
    if not header:
        return False
    parts = header.split(None, 1)
    if len(parts) != 2 or parts[0].lower() != "bearer":
        return False
    return hmac.compare_digest(parts[1].strip(), TOKEN)


def run_agent(prompt, model=None):
    """Chama o OpenCode local e devolve so o texto."""
    cmd = ["opencode", "run", "--format", "json", "--model", model or MODEL, prompt]
    try:
        proc = subprocess.run(cmd, cwd=CWD, capture_output=True, text=True, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        return "", "timeout do opencode run"
    parts = []
    for line in proc.stdout.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            continue
        if obj.get("type") == "text":
            t = (obj.get("part") or {}).get("text")
            if t:
                parts.append(t)
    return "".join(parts).strip(), proc.stderr.strip()


def list_models():
    try:
        out = subprocess.run(["opencode", "models"], capture_output=True, text=True, timeout=60).stdout
    except Exception:
        out = ""
    ids = [l.strip() for l in out.splitlines() if l.strip() and "/" in l]
    return [{"id": m, "object": "model", "owned_by": "opencode"} for m in ids]


class Handler(BaseHTTPRequestHandler):
    server_version = "oc-bridge/1.0"

    def log_message(self, fmt, *args):
        sys.stderr.write("[bridge] " + (fmt % args) + "\n")

    def _json(self, code, payload):
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.rstrip("/") == "/health":
            return self._json(200, {"ok": True, "model": MODEL, "host": HOST, "port": PORT})
        if not auth_ok(self.headers.get("Authorization")):
            return self._json(401, {"error": {"message": "missing/invalid bearer token"}})
        if self.path.split("?")[0].rstrip("/") == "/v1/models":
            return self._json(200, {"object": "list", "data": list_models()})
        return self._json(404, {"error": {"message": "not found"}})

    def do_POST(self):
        if not auth_ok(self.headers.get("Authorization")):
            return self._json(401, {"error": {"message": "missing/invalid bearer token"}})
        if self.path.split("?")[0].rstrip("/") != "/v1/chat/completions":
            return self._json(404, {"error": {"message": "not found"}})
        n = int(self.headers.get("Content-Length") or 0)
        try:
            req = json.loads(self.rfile.read(n) or b"{}")
        except json.JSONDecodeError:
            return self._json(400, {"error": {"message": "invalid JSON"}})

        msgs = req.get("messages") or []
        if not msgs:
            return self._json(400, {"error": {"message": "messages required"}})
        prompt = "\n\n".join(
            f"{m.get('role', 'user')}: {m.get('content', '')}" for m in msgs
        )
        model = req.get("model") or MODEL   # usa o modelo pedido pelo cliente
        text, err = run_agent(prompt, model)
        if not text:
            return self._json(502, {"error": {"message": "opencode run falhou", "detail": err[-400:]}})
        return self._json(200, {
            "id": "chatcmpl-bridge",
            "object": "chat.completion",
            "created": int(__import__("time").time()),
            "model": model,
            "choices": [{"index": 0, "message": {"role": "assistant", "content": text},
                         "finish_reason": "stop"}],
            "usage": {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0},
        })


if __name__ == "__main__":
    srv = ThreadingHTTPServer((HOST, PORT), Handler)
    print(f"oc-bridge em http://{HOST}:{PORT}/v1 (modelo padrao: {MODEL})", flush=True)
    print("use: Authorization: Bearer $OC_BRIDGE_TOKEN", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
