#!/data/data/com.termux/files/usr/bin/bash
# manifest-check — shim do Termux para o contrato canonico da malha.
#
# A logica vive em ai-mesh/shared/scripts/manifest-check. O Termux usa este
# shim porque o repo compartilhado precisa rodar tambem no Linux, enquanto o
# runtime do celular usa interpretadores absolutos do Termux.
#
#   manifest-check
#   manifest-check --json
#   manifest-check --check
#   manifest-check --parity
set -uo pipefail

CANON="${AI_MESH_DIR:-$HOME/ai-mesh}/shared/scripts/manifest-check"
if [ ! -f "$CANON" ]; then
  echo "manifest-check: canonical ausente: $CANON" >&2
  exit 2
fi
exec /data/data/com.termux/files/usr/bin/python3 "$CANON" "$@"
