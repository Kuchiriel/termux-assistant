#!/data/data/com.termux/files/usr/bin/python3
"""secret-scan - procura segredos nos artefatos do proprio agente.

    secret-scan            # varre tudo (config, logs, shell, estado, repo)
    secret-scan --paths    # so mostra ONDE achou (sem contar ocorrencias)
    secret-scan --check    # sai 1 se achar segredo em lugar inesperado
    secret-scan --help     # esta ajuda

POR QUE (medido 12/11 no celular):
    Inspecionar uma config que tenha segredo DESPERTA o valor no terminal — e
    se esse terminal e' a MESMA sessao do agente, o valor vai parar em: (a) no
    log do opencode, (b) nos arquivos de saida do shell, (c) no banco sqlite da
    sessao. MEDIDO: o GITHUB_TOKEN de service-android-termux.json aparecia em
    1 log (3 ocorrencias), 7 arquivos de saida do shell, opencode-stable.db (4)
    e opencode-android-termux.db (6) — e o dono nao tinha como saber.

    NESTE SCRIPT O VALOR NUNCA E' IMPRESSO NEM GRAVADO. Cada achado sai como
    caminho + numero de ocorrencias + impressao digital (sha256 do valor, 8
    chars): o suficiente para CASAR o mesmo segredo em outro lugar, sem
    reproduzi-lo. O script so LE — nunca escreve nos alvos.

REGRA DA MALHA: segredo fora do bus e do repo. Este script existe para MEDIR
onde o segredo vazou, nunca para le-lo de novo em voz alta.
"""
import argparse
import datetime
import hashlib
import json
import os
import re
import sys
from collections import Counter

HOME = os.path.expanduser("~")
CFG_DIR = os.path.join(HOME, ".config/opencode")
OC_DIR = os.path.join(HOME, ".local/share/opencode")
STATE_DIR = os.path.join(HOME, ".local/state")
REPO_DIR = os.environ.get("AI_MESH_DIR", os.path.join(HOME, "ai-mesh"))
MESH_DIR = os.path.join(STATE_DIR, "secret-scan")

# chaves cujos VALORES sao segredo
KEY_RE = re.compile(r"password|passwd|secret|token|api_?key|private_?key|credential", re.I)

# padroes de segredo reconhecidos SEM depender de valor conhecido
PATTERNS = [
    ("github-token", re.compile(rb"gh[pousr]_[A-Za-z0-9]{20,}")),
    ("github-pat", re.compile(rb"github_pat_[A-Za-z0-9_]{20,}")),
    ("openai-key", re.compile(rb"sk-[A-Za-z0-9]{20,}")),
    ("aws-key", re.compile(rb"AKIA[0-9A-Z]{16}")),
    ("private-key", re.compile(rb"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("slack-token", re.compile(rb"xox[baprs]-[A-Za-z0-9-]{10,}")),
]

MAX_BYTES = 120 * 1024 * 1024
MAX_FILES = 6000


def collect_known():
    """Segredos das configs do opencode. Devolve [(origem, valor, fp)]."""
    out = []
    for name in sorted(os.listdir(CFG_DIR)) if os.path.isdir(CFG_DIR) else []:
        if not name.startswith("service-") or not name.endswith(".json"):
            continue
        path = os.path.join(CFG_DIR, name)
        try:
            data = json.load(open(path))
        except Exception:
            continue
        vals = set()

        def walk(o):
            if isinstance(o, dict):
                for k, v in o.items():
                    if isinstance(v, (dict, list)):
                        walk(v)
                    elif isinstance(v, str) and KEY_RE.search(str(k)) and len(v) >= 8:
                        vals.add(v)
            elif isinstance(o, list):
                for v in o:
                    walk(v)

        walk(data)
        for v in vals:
            out.append((path, v, hashlib.sha256(v.encode()).hexdigest()[:8]))
    # server.env: pares CHAVE=VALOR
    envf = os.path.join(CFG_DIR, "server.env")
    if os.path.isfile(envf):
        try:
            for line in open(envf, errors="ignore"):
                if "=" not in line or line.strip().startswith("#"):
                    continue
                k, _, v = line.partition("=")
                v = v.strip().strip('"').strip("'")
                if KEY_RE.search(k) and len(v) >= 8:
                    out.append((envf, v, hashlib.sha256(v.encode()).hexdigest()[:8]))
        except Exception:
            pass
    return out


def is_expected_secret_store(path):
    """Locais onde o segredo e' esperado: config de origem e copias service-*."""
    p = os.path.realpath(path)
    base = os.path.basename(p)
    cfg = os.path.realpath(CFG_DIR)
    state_store = os.path.realpath(os.path.join(STATE_DIR, "opencode"))
    if os.path.dirname(p) == cfg:
        if (base.startswith("service-") and base.endswith(".json")) or base == "server.env":
            return True
    if os.path.dirname(p) == state_store and base.startswith("service-") and base.endswith(".json"):
        return True
    return False


def atomic_write_text(path, text):
    """Substitui o relatorio inteiro de uma vez (nunca deixa meio arquivo)."""
    tmp = "%s.tmp.%d" % (path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)


def atomic_write_json(path, data):
    tmp = "%s.tmp.%d" % (path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, ensure_ascii=False, indent=2)
        fh.write("\n")
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)


def lugar(path):
    """Classifica um caminho SEM expor o conteudo do arquivo."""
    p = os.path.realpath(path)
    repo = os.path.realpath(REPO_DIR)
    if p == repo or p.startswith(repo + os.sep):
        return "repo"
    if "/shell/" in p:
        return "shell"
    if "/log/" in p or p.endswith(".log"):
        return "log"
    if ".db" in os.path.basename(p):
        return "db"
    if p.startswith(os.path.realpath(STATE_DIR) + os.sep):
        return "state"
    if p.startswith(os.path.realpath(CFG_DIR) + os.sep):
        return "config"
    return "other"


def targets():
    """Arquivos a varrer.

    MEDIDO 12/11: os BANCOS sqlite da sessao (opencode-stable.db,
    opencode-android-termux.db) moram na RAIZ de ~/.local/share/opencode — se a
    varredura so olhar 'log/' e 'shell/', ela nao ve o banco, que e' justamente
    onde o segredo da sessao fica gravado.
    """
    out = []
    # 1) log e shell (ja varridos a parte, com os proprios limites)
    for d in (os.path.join(OC_DIR, "log"), os.path.join(OC_DIR, "shell"),
              STATE_DIR, CFG_DIR, REPO_DIR):
        if not os.path.isdir(d):
            continue
        for root, dirs, files in os.walk(d):
            dirs[:] = [x for x in dirs if not x.startswith(".git")]
            for fn in files:
                p = os.path.join(root, fn)
                try:
                    st = os.stat(p)
                except OSError:
                    continue
                if st.st_size > MAX_BYTES:
                    continue
                out.append(p)
                if len(out) >= MAX_FILES:
                    return out
    # 2) RAIZ do opencode (os bancos) — sem descer em log/ e shell/ de novo
    if os.path.isdir(OC_DIR):
        for fn in os.listdir(OC_DIR):
            p = os.path.join(OC_DIR, fn)
            if not os.path.isfile(p):
                continue
            try:
                st = os.stat(p)
            except OSError:
                continue
            if st.st_size > MAX_BYTES:
                continue
            out.append(p)
    return out


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--paths", action="store_true")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--help", "-h", action="store_true")
    a = ap.parse_args()
    if a.help:
        print(__doc__)
        return 0

    known = collect_known()
    os.makedirs(MESH_DIR, exist_ok=True)
    report = os.path.join(MESH_DIR, "ultimo.txt")
    summary_path = os.path.join(MESH_DIR, "ultimo.json")

    # fingerprints conhecidos -> valor, para casar sem imprimir
    fp_to_val = {fp: val for _, val, fp in known}
    orig_of_fp = {fp: orig for orig, _, fp in known}

    hits = []
    files = targets()
    for path in files:
        # A config de origem e suas copias service-* sao STORES ESPERADOS.
        # (reportar isto aqui seria chamar o proprio armazenamento de vazamento)
        if is_expected_secret_store(path):
            continue
        try:
            with open(path, "rb") as fh:
                data = fh.read(MAX_BYTES)
        except OSError:
            continue
        if not data:
            continue
        # (a) padroes
        for label, rx in PATTERNS:
            n = len(rx.findall(data))
            if n:
                hits.append(("PADRAO:" + label, path, n, ""))
        # (b) valores conhecidos (casamento literal, valor NUNCA sai daqui)
        for fp, val in fp_to_val.items():
            if orig_of_fp[fp] == path:
                continue  # a config de origem: ali o segredo e' esperado
            vb = val.encode()
            n = data.count(vb)
            if n:
                hits.append(("CONHECIDO", path, n, fp))

    linhas = ["%s\t%s\tocorrencias=%d\t%s\n" % (kind, path, n, fp)
              for kind, path, n, fp in hits]
    atomic_write_text(report, "".join(linhas))

    paths = {path for _, path, _, _ in hits}
    arquivos_com_hit = len(paths)
    by_place = Counter(lugar(path) for path in paths)
    by_kind = Counter("conhecido" if kind == "CONHECIDO" else kind.split(":", 1)[-1]
                      for kind, _, _, _ in hits)
    resumo = {
        "ts": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "known_secrets": len(known),
        "hits": len(hits),
        "files": arquivos_com_hit,
        "by_place": dict(sorted(by_place.items())),
        "by_kind": dict(sorted(by_kind.items())),
    }
    atomic_write_json(summary_path, resumo)

    print("secret-scan: %d segredo(s) conhecido(s) a partir das configs do opencode" % len(known))
    print("secret-scan: %d ACHADO(S) em %d arquivo(s) com segredo fora do lugar esperado" %
          (len(hits), arquivos_com_hit))
    if not a.paths:
        for kind, path, n, fp in hits[:40]:
            extra = ("\tfp=%s" % fp) if fp else ""
            print("  %-22s %s  (%d)%s" % (kind, path, n, extra))
    print("relatorio completo: %s" % report)
    print("resumo JSON: %s" % summary_path)
    if a.check:
        return 1 if hits else 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
