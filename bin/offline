# frases EN que ganham bonus quando aparecem no doc
EN_PHRASES = ["first aid", "snake bite", "running water", "high blood pressure",
              "oral rehydration", "heat stroke", "heart attack", "food poisoning"]


def expand(query: str) -> tuple[dict[str, float], list[str], bool]:
    """Devolve (termo->peso, frases EN, houve_match_no_glossario)."""
    nq = " " + norm(query) + " "
    weights: dict[str, float] = {}
    # termos originais (peso 1)
    for t in tokens(query):
        weights[t] = max(weights.get(t, 0.0), 1.0)
    # glossario: frases mais longas primeiro; entrada longa suprime a curta sobreposta
    phrase_set: set[str] = set()
    gloss_hit = False
    spans: list[tuple[int, int]] = []
    for pt, ens in sorted(GLOSSARY, key=lambda x: -len(x[0])):
        pat = r"(?<![a-z0-9])" + re.escape(norm(pt)) + r"(?![a-z0-9])"
        m = re.search(pat, nq)
        if not m:
            continue
        s, e = m.span()
        if any(s < e2 and s2 < e for s2, e2 in spans):
            continue
        spans.append((s, e))
        gloss_hit = True
        for en, w in ens:
            for t in tokens(en):
                weights[t] = max(weights.get(t, 0.0), w)
            if " " in en:
                phrase_set.add(en)
    # frases EN presentes na query ou produzidas pelo glossario PT->EN
    phrase_set.update(p for p in EN_PHRASES if " " + p + " " in nq)
    return weights, sorted(phrase_set), gloss_hit


# ── indice ───────────────────────────────────────────────────────────────────
class Doc:
    __slots__ = ("path", "name", "title", "body", "tokens", "title_tokens", "tf", "length")

    def __init__(self, path: str) -> None:
        self.path = path
        self.name = os.path.basename(path)
        raw = open(path, encoding="utf-8", errors="replace").read()
        title = ""
        body = raw
        if raw.startswith("---"):
            parts = raw.split("---", 2)
            if len(parts) >= 3:
                fm, body = parts[1], parts[2]
                m = re.search(r'^title:\s*"?(.*?)"?\s*$', fm, re.M)
                if m:
                    title = m.group(1)
        if not title:
            m = re.search(r"^#\s+(.+)$", body, re.M)
            title = m.group(1) if m else self.name
        self.title = title.strip()
        # remove a linha do titulo do corpo para nao duplicar
        self.body = re.sub(r"^#\s+.+$", "", body, count=1, flags=re.M).strip()
        self.tokens = tokens(self.body)
        self.title_tokens = tokens(self.title)
        self.tf: dict[str, int] = {}
        for t in self.tokens:
            self.tf[t] = self.tf.get(t, 0) + 1
        self.length = len(self.tokens) or 1


def load_corpus(corpus: str) -> list[Doc]:
    if not os.path.isdir(corpus):
        sys.exit(f"corpus ausente: {corpus}\nrode: mkdir -p ~/offline-corpus && copie os .md do PC")
    docs = []
    for name in sorted(os.listdir(corpus)):
        if name.endswith(".md") and not name.startswith("."):
            try:
                docs.append(Doc(os.path.join(corpus, name)))
            except OSError:
                pass
    if not docs:
        sys.exit(f"nenhum .md em {corpus}")
    return docs


def search(query: str, docs: list[Doc], k: int = 5) -> list[tuple[float, Doc, str]]:
    weights, phrases, _gloss = expand(query)
    if not weights:
        return []
    n = len(docs)
    avgdl = sum(d.length for d in docs) / n
    # document frequency (corpo + titulo)
    df: dict[str, int] = {}
    for d in docs:
        seen = set(d.tf) | set(d.title_tokens)
        for t in weights:
            if t in seen:
                df[t] = df.get(t, 0) + 1
    idf = {t: math.log(1 + (n - df.get(t, 0) + 0.5) / (df.get(t, 0) + 0.5))
           for t in weights}
    total_w = sum(weights.values()) or 1.0
    out = []
    for d in docs:
        score = 0.0
        hits = 0
        for t, w in weights.items():
            tf = d.tf.get(t, 0) + 2.5 * d.title_tokens.count(t)
            if not tf:
                continue
            hits += 1
            denom = tf + 1.5 * (1 - 0.75 + 0.75 * d.length / avgdl)
            score += w * idf[t] * tf * 2.5 / denom
        if not score:
            continue
        coverage = hits / len(weights)
        score *= 0.55 + 0.45 * coverage
        text = norm(d.title + "\n" + d.body)
        for p in phrases:
            if p in text:
                score += 2.0
        out.append((score, d, snippet(d, weights)))
    out.sort(key=lambda x: -x[0])
    return out[:k]


def snippet(d: Doc, weights: dict[str, float]) -> str:
    """Frase do corpo com mais termos da query (+ vizinhanca curta)."""
    return snippet_text(d.body, weights)


def snippet_text(body: str, weights: dict[str, float]) -> str:
    body = re.sub(r"\s+", " ", body or "")
    sentences = re.split(r"(?<=[.!?])\s+", body)
    best, best_score = "", -1e9
    for s in sentences:
        ns = set(tokens(s))
        h = sum(1 for t in weights if t in ns)
        if not h:
            continue
        score = h * 2.0
        if re.search(r"\b(use|apply|give|take|run|cover|drink|avoid|call|seek|wash|"
                     r"clean|boil|keep|do not|don't|should|must|start|stop)\b", s, re.I):
            score += 1.5
        if score > best_score:
            best, best_score = s, score
    if not best:
        best = body[:240]
    best = re.sub(r"^.*?##\s*Uso\s*", "", best).strip()
    return best.strip()[:260]


ACTION_RE = re.compile(
    r"^(how (do|can|should|would) (you|i|we)|what (should|do) (you|i|we) do|"
    r"what should be the|what (is|are) the (immediate |first |key )?(action|steps|first aid)|"
    r"how to|what is the recommended|when should you|where should you)", re.I)
PREVENT_RE = re.compile(r"\b(prevent|prevention|avoid|risks?)\b", re.I)
FACT_RE = re.compile(r"^(can|is|are|does|why|what causes|how does|what are the risks)\b", re.I)
EPISTEMIC_RE = re.compile(
    r"^(how (do|can|would) (you|i|we) (know|tell|recognize|identify|differentiate|distinguish)|"
    r"what (are|is) the (signs|symptoms|difference|risks|causes)|"
    r"why\b|can\b|is\b|are\b|does\b)", re.I)


def _hit(term: str, tks: set[str]) -> bool:
    return term in tks


def search_db(query: str, db_path: str, k: int = 5) -> list[dict]:
    """Busca FTS5 (title peso 5, body peso 1) + rerank por cobertura/intencao."""
    import sqlite3
    weights, phrases, gloss_hit = expand(query)
    if not weights:
        return []
    # porteiro de dominio: pergunta fora de saude/sobrevivencia nao casa com o corpus
    if not gloss_hit and not (set(tokens(query)) & domain_terms(db_path)):
        return []
    terms = []
    for t in weights:
        terms.append(t)
    terms.extend(f'"{p}"' for p in phrases)
    fts = " OR ".join(dict.fromkeys(terms))
    sql = """SELECT title, body, source, license, kind,
                    -bm25(docs, 8.0, 1.0) * CAST(weight AS REAL) AS score
             FROM docs WHERE docs MATCH ? %s
             ORDER BY score DESC LIMIT %d"""
    con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    try:
        rows = con.execute(sql % ("", 120), (fts,)).fetchall()
        # garante que docs curados nao sejam soterrados pelos 5.490 Q/A
        rows += con.execute(sql % ("AND kind='curado'", 10), (fts,)).fetchall()
    finally:
        con.close()
    seen: set[tuple[str, str]] = set()
    out = []
    for title, body, source, lic, kind, score in rows:
        if (title, source) in seen:
            continue
        seen.add((title, source))
        text = f"{title}\n{body}"
        tks = set(tokens(text))
        hits = sum(1 for t in weights if _hit(t, tks))
        if not hits:
            continue
        cov = hits / len(weights)
        score = float(score) * (0.65 + 0.35 * cov)
        nt = " " + norm(text) + " "
        for p in phrases:
            if f" {p} " in nt:
                score += 2.5
        if kind == "firstaidqa":
            if ACTION_RE.search(title) and not EPISTEMIC_RE.search(title):
                score += 0.5 if PREVENT_RE.search(title) else 2.2
            elif FACT_RE.search(title) or EPISTEMIC_RE.search(title):
                score -= 0.8
        elif kind == "curado":
            score *= 1.15
        out.append({"score": score, "title": title, "source": source,
                    "license": lic, "kind": kind, "body": body})
    out.sort(key=lambda r: -r["score"])
    out = out[:k]
    for r in out:
        r["snippet"] = snippet_text(r.pop("body"), weights)
    return out


def domain_terms(db_path: str | None = None, docs: list[Doc] | None = None) -> set[str]:
    """Vocabulario de dominio: glossario + titulos curados (+ docs no fallback)."""
    terms: set[str] = set()
    for _pt, ens in GLOSSARY:
        for en, _w in ens:
            terms.update(tokens(en))
    if db_path:
        try:
            import sqlite3
            con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
            try:
                for (title,) in con.execute("SELECT title FROM docs WHERE kind='curado'"):
                    terms.update(tokens(title))
            finally:
                con.close()
        except Exception:
            pass
    for d in docs or []:
        terms.update(d.title_tokens)
    return terms


# ── CLI ──────────────────────────────────────────────────────────────────────
KIND_LABEL = {
    "curado": "curado",
    "firstaidqa": "FirstAidQA · sintetico",
    "fm90": "FM 90-3",
    "fm4": "FM 4-25.11 · dominio publico",
    "nhs": "NHS Medicines",
    "kiwix": "Kiwix/Survival",
    "cooking": "Based.Cooking",
}


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="offline",
        description="Busca offline no corpus de sobrevivencia (N.O.M.A.D/Kiwix/FirstAidQA/FM 90-3). Sem internet.",
        epilog='ex.: offline "como purificar agua" -k 3',
    )
    ap.add_argument("query", nargs="*", help="pergunta (PT ou EN)")
    ap.add_argument("-k", "--top-k", type=int, default=5, help="resultados (1-10, padrao 5)")
    ap.add_argument("--json", action="store_true", help="saida JSON")
    ap.add_argument("--list", action="store_true", help="resumo do corpus")
    ap.add_argument("--no-db", action="store_true", help="ignora corpus.db (BM25 sobre os .md)")
    ap.add_argument("--corpus", default=CORPUS, help="diretorio do corpus")
    args = ap.parse_args()

    corpus = os.path.expanduser(args.corpus)
    db_path = os.path.join(corpus, "corpus.db")
    use_db = os.path.exists(db_path) and not args.no_db

    if args.list:
        if use_db:
            import sqlite3
            con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
            try:
                counts = json.loads(dict(con.execute("SELECT key,value FROM meta")).get("sources", "{}"))
                total = dict(con.execute("SELECT key,value FROM meta")).get("total", "?")
            finally:
                con.close()
            print(f"corpus.db: {total} docs")
            for kind, n in sorted(counts.items()):
                print(f"  {KIND_LABEL.get(kind, kind):38s} {n}")
        else:
            docs = load_corpus(corpus)
            for d in docs:
                print(f"{d.name}\t{d.title}")
            print(f"\n{len(docs)} docs | {sum(len(d.tokens) for d in docs)} tokens")
        return 0

    query = " ".join(args.query).strip()
    if not query:
        ap.print_help()
        return 2
    k = max(1, min(10, args.top_k))

    if use_db:
        res = search_db(query, db_path, k)
        total_docs = "?"
        try:
            import sqlite3
            con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
            total_docs = dict(con.execute("SELECT key,value FROM meta")).get("total", "?")
            con.close()
        except Exception:
            pass
    else:
        docs = load_corpus(corpus)
        raw = search(query, docs, k)
        res = [{"score": s, "title": d.title, "source": d.name,
                "license": "", "kind": "curado", "snippet": sn} for s, d, sn in raw]
        total_docs = len(docs)

    # piso de confianca: evita devolver besteira quando o corpus nao cobre o tema
    if res and res[0]["score"] < 0.45:
        res = []

    if args.json:
        print(json.dumps([{**r, "score": round(r["score"], 3)} for r in res],
                         ensure_ascii=False, indent=2))
        return 0 if res else 1
    if not res:
        print(f"SEM FONTE LOCAL: o corpus offline ({total_docs} docs) nao tem "
              f"resposta confiavel para: {query}\nNao invente — diga que nao ha fonte local.")
        return 1
    print(f"Corpus offline ({total_docs} docs, sem internet) — {query}")
    for i, r in enumerate(res, 1):
        label = KIND_LABEL.get(r["kind"], r["kind"])
        print(f"\n{i}. [{r['score']:.2f}] {r['title']}")
        print(f"   {r['snippet']}")
        extra = f" · {r['license']}" if r["kind"] != "curado" and r.get("license") else ""
        print(f"   {r['source']} · {label}{extra}")
    if any(r["kind"] == "firstaidqa" for r in res):
        print("\n⚠ FirstAidQA e corpus sintetico (CC BY 4.0): use como pista, "
              "confirme com fonte primaria antes de decisao clinica.")
    return 0



if __name__ == "__main__":
    sys.exit(main())
