#!/data/data/com.termux/files/usr/bin/python3
"""offline — busca no corpus offline de sobrevivencia (N.O.M.A.D + Kiwix).

Funciona SEM internet: le ~/offline-corpus/*.md (45 docs, ~776 KB, dominio
publico) e responde em portugues ou ingles com BM25 + expansao PT->EN.

Uso:
  offline "como purificar agua em emergencia"
  offline "queimadura o que fazer" -k 3
  offline "snake bite first aid" --json
  offline --list
  offline --help

Saida: ranking com score, titulo, trecho e arquivo. Sem match confiavel
devolve "SEM FONTE LOCAL" (nunca inventa).
"""

from __future__ import annotations

import argparse
import json
import math
import os
import re
import sys
import unicodedata

CORPUS = os.path.expanduser(os.environ.get("OFFLINE_CORPUS", "~/offline-corpus"))

# ── normalizacao ─────────────────────────────────────────────────────────────
TOKEN_RE = re.compile(r"[a-z0-9]+")

STOP = set("""
a an the and or of to in for on with at by from is are was were be been being
this that these those it its as if then than so not no nor but do does did
have has had can could should would may might must will shall about into over
under after before during while between out up down off again very more most
other some any each few both all own same too only just also
de da do das dos e ou o a os as um uma uns umas para por com sem em no na nos
nas ao aos que se um uma como onde quando porque qual quais seu sua seus suas
ele ela eles elas isso isto aquilo mais menos muito pouco ja nao sim
""".split())


def norm(text: str) -> str:
    """Minusculas sem acento (ç -> c)."""
    text = unicodedata.normalize("NFKD", text or "")
    text = "".join(c for c in text if not unicodedata.combining(c))
    return text.lower()


def stem(tok: str) -> str:
    """Stem leve: burns->burn, wounds->wound, treatment->treat(ment)? nao."""
    if len(tok) > 4 and tok.endswith("ies"):
        return tok[:-3] + "y"
    if len(tok) > 4 and tok.endswith("es") and not tok.endswith("ses"):
        return tok[:-2]
    if len(tok) > 3 and tok.endswith("s") and not tok.endswith("ss"):
        return tok[:-1]
    return tok


def tokens(text: str) -> list[str]:
    return [stem(t) for t in TOKEN_RE.findall(norm(text)) if t not in STOP and len(t) > 1]


